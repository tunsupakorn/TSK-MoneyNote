rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // แต่ละคนอ่าน/เขียนได้เฉพาะข้อมูลของตัวเองเท่านั้น (ใครมีลิงก์ก็สมัครใช้ได้ ข้อมูลแยกกัน)
    // ถ้าต้องการกลับไปใช้แบบ "เฉพาะอีเมลที่อนุญาต" ดูเวอร์ชันใน git: commit 3922293
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
