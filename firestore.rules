rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // เจ้าของแอป (จัดการรายชื่อผู้ใช้ที่อนุญาตได้)
    function isOwner() {
      return request.auth != null && request.auth.uid == 'bccZ2Cvc0sYEY9VPt6BCyqIiU9R2';
    }
    // อีเมลที่ยืนยันแล้ว (บัญชี Google ยืนยันอัตโนมัติ / บัญชีอีเมลต้องกดลิงก์ยืนยัน)
    function verifiedEmail() {
      return request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    // ใช้แอปได้: เจ้าของ, หรือเปิดให้ทุกคน, หรืออีเมลอยู่ในรายชื่อที่อนุญาต
    function allowed() {
      return isOwner()
        || (exists(/databases/$(database)/documents/config/access)
            && get(/databases/$(database)/documents/config/access).data.get('open', false) == true)
        || (verifiedEmail() && exists(/databases/$(database)/documents/allow/$(request.auth.token.email.lower())));
    }

    // ข้อมูลของแต่ละคน: อ่าน/เขียนได้เฉพาะของตัวเอง และต้องได้รับอนุญาต
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid && allowed();
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid && allowed();
      }
    }

    // ตั้งค่าการเข้าถึง: ทุกคนที่ล็อกอินอ่านได้ (มีแค่ open: true/false), เขียนได้เฉพาะเจ้าของ
    match /config/access {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }

    // รายชื่ออีเมลที่อนุญาต: เจ้าของจัดการทั้งหมด, แต่ละคนเช็กได้เฉพาะอีเมลตัวเอง
    match /allow/{email} {
      allow read: if isOwner() || (request.auth != null && request.auth.token.email != null && request.auth.token.email.lower() == email);
      allow write: if isOwner();
    }
  }
}
